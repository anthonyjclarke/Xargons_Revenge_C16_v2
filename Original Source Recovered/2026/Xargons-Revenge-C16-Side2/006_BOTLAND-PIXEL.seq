; >S:BOTLAND-PIXEL; PUT "BOTLAND-PIXEL";;BOTMVE;; MOVE THE BOTTOM LAND;LDA BOTSPDBNE BOT4;LDA #0STA IRQWRKBEQ BOT2;BOT4;CMP #1BNE BOT1;STA IRQWRK;INC BOTWRKLDA BOTWRKAND #1BNE BOT2;RTS;BOT1;SECSBC #1STA IRQWRK;BOT2;LDA BOTLXSECSBC IRQWRK ;* SPEED;TAY;AND #7STA BOTLX;TYA;AND #8BNE HARBOT ;* NEED BLOCK SCROLL;RTS;HARBOT;LDX #0;BTL2;LDA $0F21,XSTA $0F20,X;LDA $0F49,XSTA $0F48,X;LDA $0F71,XSTA $0F70,X;LDA $0F99,XSTA $0F98,X;INXCPX #39BNE BTL2;; NOW PUT ON THE NEW BIT OF HILL;DEC BOTCNTBPL BLINK2;JSR BOTNEW;BLINK2;LDX #3;BLINK3;LDY YHIL,XLDA BOTCHR;STA $F47,Y;INC BOTCHRDEXBPL BLINK3;RTS;BOTNEW;; START A NEW BLOCK;LDA #7STA BOTCNT;BLINK4;JSR RANDOM;LDA RNDAND #7CMP #6BCS BLINK4;CMP LASTONBEQ BLINK4;; DON'T CHOOSE SAME ONE AGAIN;STA LASTON;TAXLDA BOTST,X;STA BOTCHR;RTS;;BOTST .BYTE 0,32,64,96,128,160;YHIL  .BYTE 0,40,80,120;.END