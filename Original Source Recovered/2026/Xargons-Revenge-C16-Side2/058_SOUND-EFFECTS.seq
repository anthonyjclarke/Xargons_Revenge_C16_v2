; >S:SOUND-EFFECTS; PUT"SOUND-EFFECTS";; AN ATTEMPT TO WRITE A NICE; ROUTINE LIKE OUR MATE ROBBIE; DOES.;SFX;;  CALL WITH ACC SET TO SFX #;; THIS WILL CLEAR THE LAST SFX;; 0=FIRE         ;* CHAN#2; 1=EXPLOSION    ;*   "; 2=FUEL LOW     ;* ON CHANNEL 1; 3=POW SOUND    ;* ON CHANNEL 2; 4=SHIP DEAD    ;* ON CHANNEL 2;LDY SNDFLG       ;* QUIETBNE GOFX;RTS;GOFX;TAXINX;CMP #2BNE GENSIS;LDA #$80ORA FXNUMBTAX;; SET TOP BIT FOR #2;GENSIS;STX FXNUMB       ;* # + 1;LDA #%00001111STA WELLY        ;* VOLUME;CPX #1BNE SF1;;---------------------------------;; SET UP FIRING SOUND;LDA #$10STA FXCONT;LDA #0STA FXWORK;LDA #$7FSTA SOU2LOSTA SOU2HI;RTS;;---------------------------------;; SET UP EXPLOSION SOUND;SF1;CPX #2BNE SF2;LDA #12STA FXCONT;LDA #$FFSTA SOU2LOSTA SOU2HI;RTS;;---------------------------------;; SET UP LOW FUEL SOUND;SF2;BIT FXNUMB     ;* FUEL LOW ?BPL SF3;LDA #1STA FXWORK+1;STA FXTEMP+1STA SOU1LO;LDA SOU1HIAND #%11111100ORA #%00000010STA SOU1HI;RTS;;---------------------------------;SF3;CPX #4BNE SF4;; SET UP POW SFX;LDA #$18STA FXCONT;LDA #0STA SOU2LOSTA SOU2HI;RTS;;---------------------------------;SF4;CPX #5BNE SF5;; START LONG EXPLOSION OF SHIP;LDA #96STA FXCONT;RTS;;---------------------------------;SF5;RTS;;---------------------------------;*********************************;---------------------------------;REFRSH;; REFRESH SOUND EFFECTS;LDA SNDFLG        ;* SOUND ON ?BNE SNDON;NOSND;LDA VOLCTLBNE NISND         ;* LEAVE VOL.;LDA #0STA VOL;NISND;RTS;SNDON;LDA FXNUMBBEQ NOSND         ;* NONE ON;AND #$7F;CMP #1BNE SOU2;;---------------------------------;; SERVICE SFX #0;DEC FXCONT        ;* LENGTHBNE SFX1ON;JSR ENDN2         ;* END CHAN#2JMP SOU2;SFX1ON;LDA FXWORKEOR #$80STA FXWORK        ;* OTHER ONE;S1;LDX #%01000000    ;* NOISE;BIT FXWORKBPL NOISE;LDX #%00100000    ;* NORMAL;NOISE;LDA SOU1LOSECSBC #4STA SOU1LO;TXAJSR STCH2         ;* START SOUND;;---------------------------------;SOU2;LDA FXNUMBAND #$7F;CMP #2BNE SOU3;DEC FXCONTBNE SFX2ON;JSR ENDN2         ;* KILL ITJMP SOU3;SFX2ON;LDA TEDSTA SOU2LO;LDA #%01000000    ;* NOISE #2JSR STCH2;;---------------------------------;SOU3;BIT FXNUMBBPL SOU4        ;* NOT FUEL LOW;; LOW FUEL SOUND;DEC FXTEMP+1BNE SAMEB4;LDA #4STA FXTEMP+1;LDA FXWORK+1EOR #$80STA FXWORK+1;SAMEB4;BIT FXWORK+1BPL RIGT;CLCROL SOU1LO;JMP ROPE;RIGT;CLCROR SOU1LO;ROPE;LDA VOLAND #%01100000ORA #%00010000     ;* CHAN#1ORA WELLY          ;* VOLUMESTA VOL;;---------------------------------;SOU4;LDA FXNUMBAND #$7FCMP #4BNE SOU5;DEC FXCONTBNE SFX4ON;JSR ENDN2JMP SOU5;SFX4ON;LDA SOU2LOCLCADC #$40STA SOU2LO;LDA SOU2HIADC #0STA SOU2HI;LDA #%00100000    ;* SQUARE WAVEJSR STCH2;;---------------------------------;SOU5;LDA FXNUMBAND #$7FCMP #5BNE SOU6;DEC FXCONTBNE SFX5ON;JSR ENDN2JMP SOU6;SFX5ON;LDA FXCONTCMP #64BCS SIX4    ;* DONT START DECAY;LSR ALSR ASTA WELLY   ;* DECAY VOLUME;SIX4;LDA TEDSTA SOU2HILDA TED+1STA SOU2LO;LDA #%01000000    ;* NOISEJSR STCH2;;---------------------------------;SOU6;;RTS;;---------------------------------;STCH2;; CALL WITH ACC, TO STORE AT VOL.;STA IRQWRK;LDA VOLAND #%00010000    ;* LEAVE VOL/#1ORA WELLY         ;* VOLUMEORA IRQWRKSTA VOL;RTS;;---------------------------------;ENDN2;; END A SOUND ON CHANNEL 2;LDA FXNUMBAND #$80STA FXNUMB;; LOW FUEL MIGHT STILL BE ON;LDA VOLAND #%00011111STA VOL;; TURN OFF ANYTHING TO DO WITH #2;RTS;;---------------------------------;ENDN1;; END A SOUND ON CHANNEL 1;LDA FXNUMBAND #$7FSTA FXNUMB;; OTHER SOUNDS MIGHT STILL BE ON;LDA VOLAND #%01101111STA VOL;; TURN OFF ANYTHING TO DO WITH #1;RTS;;---------------------------------;;;.END