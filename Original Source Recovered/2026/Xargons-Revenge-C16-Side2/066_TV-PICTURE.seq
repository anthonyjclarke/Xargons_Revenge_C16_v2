; >S:TV-PICTURE; PUT "TV-PICTURE";; DO A BIT OF A DO-DAH IN THE TV !;TVPIC;BIT PICHITJSR SCRTVP     ;* SCROL TV PICTURE;LDA SHIPYAND #15TAX;LDA HITTBL,XTAX            ;* CALC HEIGHT;LDY #7         ;* SET RIGHT VARS;LDA #%11000000 ;* BAR VALSTA IRQWRKLDA #%10000000 ;* TOP VALSTA IRQWRK+1;BIT PICHITBPL TV3        ;* GO RIGHT;LDY #$27       ;* HERE GOING LEFT;LDA #%00000011 ;* BAR VALSTA IRQWRKLDA #%00000010 ;* TOP VALSTA IRQWRK+1;TV3;LDA IRQWRK     ;* BAR BITS;ORA $1530,YSTA $1530,Y;DEYDEX;BPL TV3;LDA IRQWRK+1   ;* TOP BIT;ORA $1530,YSTA $1530,Y;RTS;;;---------------------------------;SCRTVP         ;* SCROLL PICTURE;BMI SCLPCL     ;* SCROLL LEFT;; SCROLL PICTURE RIGHT;LDX #7;TV1;LSR $1530,XROR $1550,X;LSR $1530,XROR $1550,X;DEXBPL TV1;RTS;;---------------------------------;SCLPCL;; SCROLL PICTURE TO LEFT;LDX #7;TV2;ASL $1550,XROL $1530,X;ASL $1550,XROL $1530,X;DEXBPL TV2;RTS;;---------------------------------;HITTBL;.BYTE 6,5,4,3,2,1,0,0,1,2,3,4,5,6.BYTE 5,4,3,2,1,0;.END