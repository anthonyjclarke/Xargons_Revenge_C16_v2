; >S:DEATH-CODE; PUT "DEATH-CODE";DEATH;; HAS DIED !;LDX #1STX STOP        ;* STOP IT ALLSTX STSTOP      ;* STOP STARSSTX STSTOP+1    ;*STX STSTOP+2    ;*STX STSTOP+3    ;*;DEXSTX DEADSTX LASERS      ;* LASER OFFSTX FUELON      ;* FUEL OFFSTX FUEL        ;* FUELSTX TOPSPD      ;* SCROLL SPEEDSTX BOTSPD      ;* SCROLL SPEED;JSR CLSFUL      ;* CLEAR FUEL CHRJSR LAZCLR      ;* CLEAR LAZER CHRJSR ENDN1       ;* CLEAR SOUND#1;JSR FIZZLE      ;* DIE !;DEC LIVES       ;* 1 LIFE LESSLDA LIVESBEQ ALLOVR      ;* LOST ALL LIVES;LDA #0STA STOP;LDA #111STA FULINC      ;* RE-FILL;JMP STLOOP      ;* BACK TO GAME;ALLOVR;JSR SCREEN      ;* CLS;JMP GAMOVR      ;* GAME OVER;;;;.END