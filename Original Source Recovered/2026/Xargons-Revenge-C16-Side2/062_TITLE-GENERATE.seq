; >S:TITLE-GENERATE; PUT"TITLE-GENERATE;; SCROLL ON THE TITLE SUBROUTINE;REVTIT;LDA #0STA WORK         ;* ROW COUNT;LDX #15;REVER;STA ALIXPS,X;DEXBPL REVER        ;* CLEAR USED TAB;REVLP;JSR RANDOMLDA RND+2STA SCRDIR       ;* RANDOM DIR.;LDA RND+1AND #15TAX;LDA ALIXPS,X     ;* THIS ONE DONE?BNE REVLP        ;* YES;LDA #1STA ALIXPS,X     ;* DONE NOW;TXA;JSR SCRLIT       ;* SCROLL IT ON;INC WORKLDA WORKCMP #16BNE REVLP        ;* DO 16 LINES;RTS;;.END