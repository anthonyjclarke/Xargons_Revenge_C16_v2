; >S:PAUSE/ESCAPE; PUT"PAUSE/ESCAPE";; SCAN PAUSE AND ESCAPE KEYS;CHKESC;; ESCAPE;LDA #$10LDY #$BFJMP KEYIT  ;* SCAN KEY;;---------------------------------;CHKPAS;; PAUSE;JSR SCANPBCS LA     ;* HELP TO PAUSE;RTS        ;* NOT PRESSED;LA;LDX #1STX PAUSESTX STOPSTX STPSTR ;* STOP STARS;DEXSTX JUPSTX JDOWNSTX JFIRE  ;* KILL ALL MOVE;LDA VOLSTA WORK   ;* SAVE VOLUME STAT.;STX VOL    ;* SND OFF;LDX #4;WIND1;TXACLCADC #250STA $0DC9,X      ;* 'PAUSE ON';LDA #$71STA $09C9,X      ;* NEW COLOUR;TXACLCADC #34STA $0DC9+40,X   ;* 'G' TO PLAY;LDA #$67STA $09C9+40,X   ;* COLOUR;DEXBPL WIND1;NYC1;JSR RUSRAS;JSR NOBBLY;JSR SCANGBCC NYC1   ;* G TO GO AGAIN;LDA #0STA STOPSTA PAUSESTA STPSTR ;* STARS GO AGAIN;LDA WORKSTA VOL    ;* SOUND ON AGAIN;LDX #4LDA #32;NYC2A;STA $0DC9,XSTA $0DC9+40,X;DEXBPL NYC2A;; CLEAR THE MESSAGE;RTS        ;* ALL OVER !;;---------------------------------;SCANP;LDA #$10LDY #$7FJMP KEYIT;;---------------------------------;SCANG;LDA #$04LDY #$F7JMP KEYIT;;---------------------------------;NOBBLY;INC WORK+1;LDA WORK+1LSR ALSR ALSR ALSR A;AND #1TAY;LDX #4;NOBB1;LDA FLID1,YSTA $09C9,X;LDA FLID2,YSTA $09C9+40,X;DEXBPL NOBB1;RTS;FLID1 .BYTE $67,$71FLID2 .BYTE $71,$67;;;.END