; >S:STARTER; PUT "STARTER";;     ANOTHER IDEA RIPPED OFF;     XARGON WARS.;STARTE;LDA #1LDX #3;PRE1;STA STSTOP,X;DEXBPL PRE1         ;* STOP ALL STARS;LDA #0STA STPSTR       ;* STARS GOSTA WORK         ;* MESSAGES COUNT;STARLP;LDA STFLAG       ;* DO MESSAGE ?BEQ SHAME;JSR PRTESC       ;* PRINT MESSAGE;SHAME;LDX WORKLDA #0STA STSTOP,X     ;* START STARS;LDA SPDTOP,XSTA TOPSPDLDA SPDBOT,XSTA BOTSPD       ;* LAND SPEED;LDA WORKCMP #3           ;* NO DELAY ONBEQ KANSAS       ;* LAST ONE .;LDX #128;LDA STFLAGBEQ FATSE;LDX #0           ;* FIRST TIME;FATSE;JSR DELAY+2;KANSAS;INC WORKLDA WORKCMP #4BNE STARLP       ;* ALL 4 SPEEDS;RTS;;---------------------------------;TESCO;; READY;.BYTE 0,0,1,2,8,9,10,0,0;; STEADY;.BYTE 0,0,3,6,2,8,9,10,0;; GO FOR IT;.BYTE 11,7,0,4,7,1,0,5,6;; '         ';.BYTE 0,0,0,0,0,0,0,0,0;;---------------------------------;PRTESC;LDY WORKLDX TIM9,Y      ;* START OF MESS.;LDY #0;ESC1;LDA TESCO,X     ;* CHARBNE ESC2        ;* NOT SPACE;LDA #32         ;* 32/2;ESC2;CMP #32BEQ ESC4;ASL ACLCADC #152        ;* BASE CHAR;ESC4;STA WRIGHT,Y    ;* L.H.CHAR;CMP #32BEQ ESC3;CLCADC #1;ESC3;STA WRIGHT+1,Y  ;* R.H.CHAR;STX WORK+1;LDX WORKLDA STARCL,X    ;* COLOUR;                 STA WRIGHT-$400,YSTA WRIGHT-$3FF,Y;LDX WORK+1;INX             ;* NEXT LETTER;INYINYCPY #18BNE ESC1        ;* WHOLE MESSAGE;RTS;;---------------------------------;STARCL .BYTE $52,$54,$56,$71;SPDTOP .BYTE 0,1,2,3;SPDBOT .BYTE 1,2,3,4;;.END