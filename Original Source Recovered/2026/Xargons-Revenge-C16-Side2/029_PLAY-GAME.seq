; >S:PLAY-GAME; PUT "PLAY-GAME";; HOLD ALL THE ROUTINES TOGETHER;START;JSR CLVARS  ;* CLEAR VARS;JSR INSTAR  ;* INIT STARS;;---------------------------------;;      SET SHIP START VARS;LDA #7STA SHIPY;LDA #3STA YPIX;LDA #<$0DB9STA SHPSCRSTA SHPCOL;LDA #>$0DB9STA SHPSCR+1;LDA #>$09B9STA SHPCOL+1;LDA #COLSH1STA SHPINK;;---------------------------------;LDA #1STA FIRCNTSTA FUTEMSTA ALTEMSTA MESSPDSTA STFLAG  ;* DO STARTER ?;LDA #5STA LIVES   ;* # LIVES;LDA #111STA FULINC  ;* HAVE SOME FUEL;REPLAY;LDA #0STA STOP    ;* ALL GOSTA SHEET   ;* START SHEET NUMBERSTA LEVEL   ;* START LEVEL NUMBER;STLOOP      ;* RESTART LOOP;LDX #1STX DNTFIR  ;* NO SHOOTINGSTX STPSTR  ;* NO STARS;DEXSTX KILLCO  ;* ENABLE DIK;JSR SETSHT  ;* SET SHEETJSR ALIDEF  ;* GET ALIEN CHARSJSR SCREEN  ;* SET SCREENJSR PRSHIP  ;* PRINT SHIP;LDA #0STA DEAD    ;* CLEAR DEAD FLAGSTA CTLFUL  ;* ALLOW FUEL FLOWSTA ALIHIT  ;* NUMBER HIT.STA FUELTM  ;* FUEL POD TEMPO;JSR STARTE  ;* READY,STEADY,GO;LDA #0STA DNTFIR  ;* START FIRINGSTA STFLAG  ;* ONLY START ONCE !;LOOP;JSR CHKPAS  ;* CHECK FOR PAUSE;JSR CHKESC  ;* CHECK ESCAPEBCC FLEETW  ;* NO;JMP TITLOP  ;* GO TO TITLE PAGE;FLEETW;JSR ALIENS;LDA DEAD    ;* DIED ?BEQ LOOP    ;* NO GO BACK;JMP DEATH   ;* DO DEATH;;;.END