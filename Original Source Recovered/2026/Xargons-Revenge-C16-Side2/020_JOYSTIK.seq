; >S:JOYSTIK; PUT "JOYSTIK";;*******************;; READ THE JOYSTICK;;*******************;REDJOS;LDA KILLCOBEQ OKYAK;RTS;OKYAK;LDA JOYSELBNE READDK      ;* JOY SELECTED;JMP KEY;READDK;LDA #$FD        ;* PORT 0STA JPORT;LDA #$4ASTA XTRCDE      ;* 'LSR A';LDA JPORTEOR #$FFBNE NAYE;; TRY PORT 1;LDA #$FA        ;* PORT 1STA JPORT;LDA #$EASTA XTRCDE      ;* 'NOP';LDA JPORTEOR #$FF;NAYE;STA JMOVE;ROR AROR JUP;ROR AROR JDOWN;LSR ALSR ALSR ALSR ALSR A;XTRCDE;NOP;ROR JFIRE;RTS;;.END