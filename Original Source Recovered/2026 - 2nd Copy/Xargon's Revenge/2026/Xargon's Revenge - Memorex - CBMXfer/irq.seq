; >S:IRQ; PUT "IRQ";;*********************;; ALL THE IRQ ROUTINES;;*********************;SETIRQ;SEI;LDA #<SERVSTA $FFFELDA #>SERVSTA $FFFF;LDA #<RESETSTA $FFFASTA $FFFC;LDA #>RESETSTA $FFFBSTA $FFFD;LDA #%00000010STA IRQMSK;; ENABLE IRQ'S FROM RASTER;LDA #0STA INTYPE;CLI;RTS;;---------------------------------;SERV;;    IRQ COMES HERE - WOW !!!;PHA;TXAPHA;TYAPHA;LDA IRQREGSTA IRQREG ;* RESET BITS;LDX INTYPE ;* RASTER NUMBER;INXCPX #5BNE NOLAST;LDX #0;NOLAST;STX INTYPE;;;*************************;; RASTER SERVICE ROUTINE;;*************************;TXAASL ACLCADC INTYPE;STA BRAN+1;BRAN;BNE BRAN;JMP RAST1JMP RAST2JMP RAST3JMP RAST4JMP RAST5;;************;;  IRQ EXIT;;************;IRQEND;STA RASCOM;PLATAY;PLATAX;PLA;RTI;;;.END