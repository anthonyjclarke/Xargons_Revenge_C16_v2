; >S:KEY-SCAN; PUT "KEY-SCAN";; THIS WILL BE CALLED FROM THE; JOYSTICK READ ROUTINE IF IT; FINDS THERE IS NO JOYSTICK; MOVEMENT,; IT WILL THEN CLEAR OR SET THE; APPROPRIATE VARIABLES IF KEYS; ARE PRESSED;KEY;LDA #0STA JMOVE;LDX #2;SCAN1;LDA BTD,XLDY RWD,X;JSR KEYIT;ROR JUP,X;DEXBPL SCAN1;RTS;; UP    = 'A'; DOWN  = 'Z'; FIRE  = 'RETURN';KEYIT;STY $FD30STY $FF08AND $FF08;BNE RTTY;LDA #1STA JMOVE      ;* A MOVEMENT;SECRTS;RTTY;CLCRTS;;--------------------------------;BTD;      U   D   F;.BYTE $20,$80,$02;RWD;.BYTE $FD,$FB,$FE;.END