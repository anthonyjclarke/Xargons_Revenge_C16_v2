; >S:FUEL-GAUGE; PUT"FUEL-GAUGE";;---------------------------------;;         FUEL BAR STUFF;;---------------------------------;PRTFUL;LDX #13;PREN2;LDA #108        ;* EMPTYSTA $0C1A,X;LDA ROSS1,XSTA $081A,X     ;* COLOUR;LDA #109STA $0C1A+40,X  ;* SCALE;LDA ROSS2,XSTA $081A+40,X;DEXBPL PREN2;RTS;;--------------------------------;UPFUEL      ;* PRINT FUEL GAUGE;LDX #2;LDA FUELCMP #24BCC HIWIRE  ;* <24 = RED;LDX #7;CMP #72BCC HIWIRE  ;* >24 & <72 = YELLOW;LDX #5;HIWIRE;STX IRQWRK  ;* BAR COLOUR;LDX #13;MORGAN;LDA #108STA $0C1A,X;LDA $081A,XAND #%11110000ORA IRQWRKSTA $081A,X ;* PUT COLOUR IN;DEXBPL MORGAN;; ALWAYS CLEAR GAUGE FIRST;LDA FUELAND #7TAXLDA ENDBIT,X;LDY #7;MORG1;STA $3B58,Y;DEYBNE MORG1     ;* PROG END CHAR;LDA FUELLSR ALSR ALSR A;TAX           ;* NO. OF FULL CHARS;LDA #107      ;* END PIECE;MORG2;STA $0C1A,X;LDA #106      ;* FULL NOW;DEXBPL MORG2     ;* BAK TO START;RTS;;--------------------------------;FUELDO;LDA FULINCBNE MOON       ;* CANT GO DOWN;LDA CTLFUL     ;* DO FUEL STUFFBEQ DOITYA;MOON;RTS;DOITYA;DEC FUTEM      ;* TEMPOBNE HMMM;LDA MPGVAL     ;* TEMPOSTA FUTEM      ;* RESET TEMPO;LDA DEADBNE HMMM;SHOTFL         ;* SHOOT FUEL;DEC FUELBNE HMMM;LDA #1STA DEADRTS;HMMM;LDA FUELCMP #24BCS NIGHT;LDA FXNUMB    ;* SOUND ALREADY ONBMI BYESND;; START THE FUEL LOW SOUND.;LDA #2JSR SFX       ;* LOW FUEL SFX;BYESND;JSR PULSATAND #%11110000ORA #%00001010 ;* REDSTA SHPINK;JMP DAY;NIGHT;LDA #COLSH1STA SHPINK    ;* RESET SHIP COLOUR;JSR ENDN1     ;* LOW FUEL FX OFF;DAY;RTS;;---------------------------------;ADFUEL;LDA CTLFULBNE WANNA;LDA FULINC ;* ANY TO ADD ?BNE ADDE1;WANNA;RTS;ADDE1;LDA FUELCLCADC #1CMP #111BCC ADOKY  ;* STILL OK;LDA #111STA FUEL   ;* FULL UP;LDA #0STA FULINC ;* STOP GOING UP;RTS;ADOKY;STA FUEL;DEC FULINC ;* REQUEST;RTS;;---------------------------------;; COLOUR FOR FUEL GAUGE;ROSS1;.BYTE $16,$16,$26,$26,$36,$36.BYTE $46,$46,$56,$56,$66,$66.BYTE $76,$76;ROSS2;.BYTE $42,$42,$42,$67,$67,$67,$67.BYTE $67,$67,$55,$55,$55,$55,$55;ENDBIT;.BYTE %00000000.BYTE %10000000.BYTE %11000000.BYTE %11100000.BYTE %11110000.BYTE %11111000.BYTE %11111100.BYTE %11111110;;;.END