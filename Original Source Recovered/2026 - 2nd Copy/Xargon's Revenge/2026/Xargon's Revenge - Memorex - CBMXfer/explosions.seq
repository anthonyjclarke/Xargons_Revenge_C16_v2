; >S:EXPLOSIONS; PUT "EXPLOSIONS";; GENERATE EXPLOSION CHARS FROM; ALIEN CHARS FOR THIS SHEET;CALEXP;LDA #0STA WORK      ;* COUNT, 4 ANIMS;EXPLOP;;---------------------------------;; GET ALIEN ANIMATION TO WORK ON;LDA WORKAND #1TAY;LDX TIM32,YLDY #0;EXP1;LDA $3EA8,X      ;* ALIEN DATASTA BIGBUF,YSTA BIGBUF+32,Y  ;* SAVE MASK;INXINYCPY #32BNE EXP1;;---------------------------------;LDA WORK; ASL ATAY;; NUMBER OF TIMES TO FIZZLE;EXP2;LDX #31;EXP3;LDA TEDAND BIGBUF+32,X  ;* MASKSTA BIGBUF,XSTA BIGBUF+32,X;DEXBPL EXP3;DEYBPL EXP2;;---------------------------------;; SAVE EXPLOSION TO EXPCHAR;LDA WORKEOR #3TAY;LDX TIM32,Y;LDY #0;EXP4;LDA BIGBUF,YSTA $3EE8,X;INXINYCPY #32BNE EXP4;;---------------------------------;INC WORKLDA WORKCMP #4BNE EXPLOP;RTS;;;.END