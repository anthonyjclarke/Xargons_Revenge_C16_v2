; >S:FIZZLE; PUT "FIZZLE";; FIZZLE PLANE AT DEATH.;FIZZLE;JSR PRSHIP    ;* SHIP ON;LDA #4JSR SFX       ;* START SFX;LDX #95;FIZ1;LDA SHIPCH,XSTA BIGBUF,X;DEXBPL FIZ1;; SAVE CURRENT SHIP DATA FOR MASK;;---------------------------------;LDA #64STA WORK          ;* LOOP;FIZ2;LDX #95;FIZ3;LDA SHIPCH,XEOR TED           ;* RND #AND BIGBUF,XSTA SHIPCH,X;DEXBPL FIZ3          ;* WHOLE CHAR;JSR RUSRAS        ;* DELAY;DEC WORKBNE FIZ2          ;* COUNT;LDA #10STA WORK          ;* FADE OUT NOW;                FIZ4;LDX #95;FIZ5;LDA TEDAND SHIPCH,XSTA SHIPCH,X      ;* FADE OUT;DEXBPL FIZ5;LDX #24JSR DELAY+2;JSR RUSRAS;DEC WORKBPL FIZ4;RTS;;.END