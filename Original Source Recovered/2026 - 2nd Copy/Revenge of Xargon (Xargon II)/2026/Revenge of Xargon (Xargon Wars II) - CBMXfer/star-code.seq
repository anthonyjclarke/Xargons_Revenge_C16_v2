; >S:STAR-CODE; PUT "STAR-CODE";;*********************************;; ALL THOSE WONDERFULL;  3 - SPEED STARS;;*********************************;;     INIT & DEFINE STAR TABLE;;*********************************;; TABLE FORMAT :-;; BYTE #;;   0     X POSITION 0-159;   1     Y POSITION 5-21;;INSTAR;LDA #0    ;* STAR COUNTSTA NUMB;ST1;JSR RANDOM;LDA NUMBASL A           ;* POINTER * 2TAX;LDA RND+1CMP #159        ;* X CO-ORDBCS ST1         ;* 0-160 ONLYSTA STARTB,X;LDA RND+2AND #$F         ;* 0 - 15;CLCADC #4          ;* TOP OF SCREEN;STA STARTB+1,X  ;* Y POS;INC NUMBLDA NUMBCMP #STARNM;BNE ST1;RTS;;***************************;; RUBOUT,MOVE AND PRINT STARS;;***************************;STARS;LDA STPSTR      ;* STARS ?BEQ GOSTAR;RTS;GOSTAR;LDA #0STA NUMB;MVESTR;LDA NUMBPHAASL ASTA POINT       ;* TABLE POINTER;PLAAND #3PHA             ;* SAVE FOR LATERTAX;LDA STCOLS,X    ;* STAR COLORSSTA STCOL;INXSTX SPEED       ;* 1,2,3,4 SPEED;LDX POINTLDA STARTB+1,X  ;* Y POSSTA TY;JSR STARXY      ;* GET SCREEN ADD.;LDA STARTB,X    ;* X POSSTA TX;PLATAX;LDA STSTOP,XBNE STATNW      ;* STOP THIS ONE;LDA TXLSR ALSR ATAY;LDA (SL),YCMP #102BCC FUKOFF;CMP #106BCS FUKOFF;LDA #32STA (SL),Y     ;* RUB IT OUT;FUKOFF;LDA TX         ;* X POSSECSBC SPEEDSTA TX;CMP #4BCS STATNW     ;* START NEW ?;; START A NEW STAR;JSR RANDOM;LDA RND+1AND #15CLCADC #4STA TY         ;* NEW Y POS;LDA #159       ;* X TO RIGHTSTA TX;STATNW;LDX POINT;LDA TXSTA STARTB,X;LDA TYSTA STARTB+1,X;; NEW VALUES INTO TABLE;JSR STARXY    ;* CALC COLUMN;LDA TX        ;* X POSLSR ALSR A         ;* /4TAY;LDA (SL),YCMP #32BEQ PRTIT     ;* PRINT STAR;CMP #102BCC DNTPRT    ;* DONT PRINT;CMP #106BCS DNTPRT    ;* TOO BIG;PRTIT;LDA TX        ;* FROM THE LOWESTAND #3        ;* 3 BITS CALCULATECLC           ;* THE STAR CHAR.ADC #102      ;* = BASE CHARSTA (SL),Y;LDA SL+1SECSBC #4STA SL+1      ;* CALC COLOUR;LDA STCOL     ;* STAR COLOURSTA (SL),Y;DNTPRT;INC NUMBLDA NUMBCMP #STARNMBEQ MVEEND;JMP MVESTR;MVEEND;RTS;;---------------------------------;STARXY;ASL ATAY;LDA SCRPOS,YSTA SL;LDA SCRPOS+1,YSTA SL+1;RTS;;---------------------------------;STCOLS;.BYTE $41,$51,$61,$71;.END