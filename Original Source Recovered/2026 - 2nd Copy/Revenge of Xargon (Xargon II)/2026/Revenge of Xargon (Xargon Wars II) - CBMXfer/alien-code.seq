; >S:ALIEN-CODE; PUT "ALIEN-CODE";; DO ALL THE ALIEN MOVE CODE;ALIENS;LDA #1;DEC ALTEM      ;* MOVE TEMPOBNE MVEALL;LDA #64STA ALTEM      ;* RESET TEMPO;LDA #0         ;* MOVE;MVEALL;STA NOBBO;; RUB,MOVE THEN REPRINT;LDA #0STA ALIPNT     ;* POINTER;ALILOP;LDX ALIPNT;LDA ALSTAT,X   ;* STATUSCMP #$FFBEQ ALDEAD     ;* THIS ONE'S DEAD;AND #$80BEQ NOTEXP     ;* NOT EXPLSOSION;; JSR UPEXPL     ;* DO EXPLOSIONJMP ALDEAD     ;* NEXT ONE;NOTEXP;LDA ALIXPS,X   ;* X POSSTA ALX;LDA ALIYPS,X   ;* Y POSSTA ALY;LDA NOBBO      ;* JUST PRINT ?BNE M10;; IF NOBBO IS '1' THEN JUST; PRINT HIM & DO THE CHECKING; FOR THE LASER;LDA ALIIND,X   ;* MOVE INDEXTAY;LDA (PATD),Y   ;* MOVE DATASTA ALIDIR;INYLDA (PATD),Y   ;* NEXT MOVEMENT;CMP #$FFBNE NTENDA;LDY #0;NTENDA;TYA;STA ALIIND,X   ;* UPDATE INDEX;JSR RUBALI;; RUB HIM OUT;LDA #1BIT ALIDIR     ;* UPBEQ NOALUP;JSR ALUP;NOALUP;LDA #2BIT ALIDIR     ;* RIGHTBEQ NOALRI;JSR ALRI;NOALRI;LDA #4BIT ALIDIR     ;* DOWNBEQ NOALDO;JSR ALDO;NOALDO;LDA #8BIT ALIDIR     ;* LEFTBEQ NOALLE;JSR ALLE;NOALLE;LDX ALIPNT;LDA ALXSTA ALIXPS,XLDA ALYSTA ALIYPS,X;; ALX,ALY NOW POINT TO NEW POS;M10;JSR PRTALI;; PRINT HIM;ALDEAD;INC ALIPNT     ;* POINTER;LDA ALIPNTCMP #ALINUMBNE ALILOP;RTS;;;-------------------------------;ALUP;; MOVE ALIEN UP;LDA ALYBNE ALYOK1;RTS;ALYOK1;DEC ALY;RTS;;*****************;ALRI;; MOVE ALIEN RIGHT;LDX ALXINXCPX #39BCC ALXOK1;LDX #0;ALXOK1;STX ALX;RTS;;*****************;ALDO;; MOVE ALIEN DOWN;LDA ALYCMP #14BCC ALYOK2;RTS;ALYOK2;INC ALY;RTS;;*****************;; MOVE ALIEN LEFT;ALLE;LDX ALXDEXBPL ALXOK2;LDX #39;ALXOK2;STX ALX;RTS;;;;;;.END