; >S:MESSAGE-STUFF; PUT "MESSAGE-STUFF";MESSVE;LDA MESSXSECSBC MESSPD ;* SCROLL SPEED;TAY;AND #7STA MESSX;TYA;AND #8BNE MESHIL ;* NEED BLOCK SCROLL;RTS;MESHIL;LDX #0;MSL1;LDA $0FC1,XSTA $0FC0,X;INXCPX #39BNE MSL1;; PUT NEXT LETTER ON;INC MESLBNE MSL2;INC MESL+1;MSL2;RUPERT;LDY #0LDA (MESL),Y;CMP #$FFBNE NTMSED;LDA #<MESSTSTA MESL;LDA #>MESSTSTA MESL+1;BNE RUPERT;NTMSED;AND #$3FSTA $FC0+39     ;* TO SCREEN;RTS;;;;;;;.END