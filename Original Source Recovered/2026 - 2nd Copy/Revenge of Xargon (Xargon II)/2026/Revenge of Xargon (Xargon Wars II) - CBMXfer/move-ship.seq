; >S:MOVE-SHIP; PUT "MOVE-SHIP";SHIP;; RUBOUT,MOVE THEN PRINT;LDA JMOVEBNE SHIPMT ;* HAS MOVED;JMP SHIPON ;* SHIP PRINT;SHIPMT;BIT JFIRE    ;* WANT TO FIRE ?BPL NFIRE;LDA DNTFIR   ;* ALLOW TO FIRE ?BNE FIROUT   ;* NO;DEC FIRCNT   ;* FIRE TEMPOBNE FIROUT;; TEMPO IS OK - YAH !;LDA #4STA FIRCNT;LDA JFIRECMP OLDFIR   ;* TAKE YOUR FINGERBEQ FIROUT   ;* OFF THE BUTTON !;STA OLDFIR;JSR FIRE     ;* DO MEGA CODE;FIROUT;LDA JUPORA JDOWN    ;* WANT TO MOVE ?BMI NFIRE    ;* YES;JSR SHIPON   ;* PRINT SHIP;RTS;;---------------------------------;NFIRE;JSR CHKSHP   ;* CHECK SHIP FIRST;LDX #11;SHP1;LDY YSHIP,X  ;* Y VALUESLDA #32      ;* SPACESTA (SHPSCR),Y;DEXBPL SHP1;; GONE NOW !!;; LETS SEE IF HE WANTS TO MOVE NOW;BIT JUPBPL NOUP     ;* NOT UP;LDA SHIPYBNE UPOK     ;* AT TOP;LDA YPIXCMP #2BCC NOUP;; IF AT TOP THEN CHECK IF ALSO; AT PIXEL TOP - IN WHICH CASE; YOU CANT GO UP;UPOK;LDA YPIX     ;* PIXEL POS (0-7)SECSBC #2       ;* PIXEL UP;TAY;AND #7STA YPIX     ;* NEW PIXEL POS;TYAAND #8       ;* NEED BLOCK MOVE ?;BEQ NOUP     ;* GET OUT;DEC SHIPY    ;* HARD CHAR POS;LDA SHPSCRSECSBC #40STA SHPSCRSTA SHPCOL   ;* UP 1 CHAR;LDA SHPSCR+1SBC #0STA SHPSCR+1;SECSBC #4STA SHPCOL+1 ;* COLOUR CALC;NOUP;; LETS SEE IF HE WANTS TO GO DOWN;BIT JDOWNBPL NODOWN   ;* NO - GO AWAY !;LDA SHIPY    ;* Y POSCMP #13;BNE DOWOK    ;* NO PROBLEMS;LDA YPIX     ;* IF AT THE BOTTOMCMP #6       ;* THEN CHECK IF ALSOBCS NODOWN   ;* AT PIXEL BOTTOM;DOWOK;LDA YPIX     ;* PIXEL POS (0-7)CLCADC #2       ;* PIXEL UP;TAY;AND #7STA YPIX     ;* NEW PIXEL POS;TYAAND #8       ;* NEED BLOCK MOVE ?;BEQ NODOWN   ;* GET OUT;INC SHIPY    ;* HARD CHAR POS;LDA SHPSCRCLCADC #40STA SHPSCRSTA SHPCOL   ;* UP 1 CHAR;LDA SHPSCR+1ADC #0STA SHPSCR+1;SECSBC #4STA SHPCOL+1 ;* COLOUR CALC;NODOWN;JSR PRSHIP   ;* DO ALL PIXEL CALCS;RTS;;;;;.END