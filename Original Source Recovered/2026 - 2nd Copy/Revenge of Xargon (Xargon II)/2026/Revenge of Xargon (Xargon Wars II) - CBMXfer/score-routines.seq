; >S:SCORE-ROUTINES; PUT "SCORE-ROUTINES";;SCORE;LDY #7       ;* LSB DIGIT;; SECOND ENTRY POINT;STA SCRADD;ADDLOP;LDA SCRADD;MADONA;CLCADC SCRBUF,YCMP #10BMI SCOREL;SECSBC #10STA SCRBUF,Y;LDA #1DEYBPL MADONA;SCOREL;STA SCRBUF,Y;;---------------------------------;; NOW PRINT SCRBUF TO THE SCREEN.;SCORPT;LDX #7;SCRPRT;LDA SCRBUF,XASL ACLCADC #82STA SCORPS,X      ;* TOP HALF;CLCADC #1STA SCORPS+40,X   ;* BOTTOM BIT.;LDA #$55STA SCORPS-$400,XLDA #$45STA SCORPS-$400+40,X;DEXBPL SCRPRT;RTS;;;.END