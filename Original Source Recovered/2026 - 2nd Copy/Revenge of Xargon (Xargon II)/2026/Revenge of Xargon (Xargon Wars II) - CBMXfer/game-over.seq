; >S:GAME-OVER; PUT "GAME-OVER";; PRINT GAME OVER AND FLASH A BIT!;GAMOVR;LDA #1STA STPSTR       ;* STOP STARS;LDX #0;OVR1;TXACLCADC #186STA $0D9F,X      ;* TOP ROW;CLCADC #9STA $0D9F+40,X   ;* NEXT;CLCADC #9STA $0D9F+80,X   ;* AND BOTTOM ROW;LDA #$49STA $099F,XSTA $099F+40,XSTA $099F+80,X   ;* COLOUR;INXCPX #9BNE OVR1;JSR HIGH         ;* HIGH SCORE ?;LDA #$71STA SHIPC2;ERIC;LDA TEDAND #15;BEQ ERIC         ;* NO BLACK;STA WORK+1;LDA #0STA STPSTRSTA WORK         ;* LOOP;OVR2;JSR PULSATAND #%11110000   ;* LUMINENCEORA WORK+1       ;* OUR COLOURSTA SHIPC1       ;* FLASH COLOURS;LDA WORK+2BEQ OVR4         ;* NO HIGH SCORE;LDA WORKLSR ALSR ALSR A;AND #1           ;* 0 OR 1ORA #$70         ;* LUMINENCE;LDX #38;OVR3;STA $0A31,X;DEXBPL OVR3         ;* WHOLE LINE;OVR4;JSR RUSRAS;DEC WORKBNE OVR2         ;* WAIT;JMP TITLOP;;.END