; >S:SHIP-CALCS; PUT "SHIP-CALCS";; WITH THE INFO IN YPIX & SHIPY; PRINT THE SHIP ON;PRSHIP;LDX #95LDA #0;PRS1;STA SHIPCH,X;DEXBPL PRS1;; CLEARED OLD DATA;LDX #0        ;* PIXELS HIGH COUNTLDY YPIX      ;* Y POS;PRS2;LDA SHPDT1,X  ;* DATA COL #1STA SHIPCH,Y;LDA SHPDT2,X  ;* DATA COL #1STA SHIPCH+24,Y;LDA SHPDT3,X  ;* DATA COL #1STA SHIPCH+48,Y;LDA SHPDT4,X  ;* DATA COL #1STA SHIPCH+72,Y;INYINXCPX #16BNE PRS2;; NOW LETS PRINT IT ON;SHIPON;JSR CHKSHP      ;* CHECK;LDX #11;PRS3;LDY YSHIP,XLDA SHPCHR,X;STA (SHPSCR),Y;LDA SHPINK      ;* COLOURSTA (SHPCOL),Y;DEXBPL PRS3;RTS;;---------------------------------;; CHECK SHIP;; IF YPIX = 0 THEN IS AT TOP OF; CHAR SO ONLY CHECK TOP 2 ROWS.;; SIMILAR OR YPIX = 6 EXCEPT CHECK; THE BOTTOM TWO ROWS.;CHKSHP;LDX #0          ;* START CHECKLDY #12         ;* END CHECK;LDA YPIXBNE SHOP1       ;* NOT AT TOP;LDY #8          ;* ONLY 2 ROWS;SHOP1;CMP #6BNE SHOP2       ;* NOT AT BOTTOM;LDX #4;SHOP2;STY IRQWRK;SHOP4;LDY YSHIP,X     ;* Y VALLDA (SHPSCR),Y;CMP #180BCC SHOP3;CMP #186BCS SHOP5;; HIT A FUEL POD;LDA #1STA KILFUL     ;* KILL FUEL PODBNE SHOP6;SHOP5;LDA #1STA DEAD;SHOP3;INXCPX IRQWRKBNE SHOP4       ;* ALL CHARS;SHOP6;RTS;;;.END