; >S:FUEL-GAUGE; PUT"FUEL-GAUGE";;----------------;; FUEL BAR STUFF;;----------------;FULBAS = 106      ;*BASE CHAR;PRTFUL   ;*PRINT ENERGY BARS;LDX #12;PREN2;LDA #FULBASSTA $0C1B,X;LDA #FULBAS+9STA $0C1B+40,X;LDA ROSS,XSTA $081B,XSTA $081B+40,X;DEX;BPL PREN2;RTS;;--------------------------------;UPFUEL      ;* PRINT FUEL GAUGE;LDY #0;LDA FUELCMP #8BCC MIDSTA ;*IS FUEL VALUE <8;AND #%11111000LSR ALSR ALSR ATAX        ;*HOW MANY SOLID CHARS;DIFF1;LDA #FULBAS+8;JSR MPRINTINYDEXBNE DIFF1  ;*PRINT SOLID BIT;MIDSTA;LDA FUELAND #%00000111CLCADC #FULBASJSR MPRINT;TESTE;INYCPY #12BCS ENDNE;LDA #FULBASJSR MPRINTJMP TESTE;ENDNE;RTS;MPRINT;STA $C1B,YPHATYA;CLCADC #40TAYPLACLCADC #9STA $C1B,Y;TYASECSBC #40TAY;RTS;;--------------------------------;FUELDO;DEC FUTEM      ;* TEMPOBNE HMMM;LDA #32STA FUTEM      ;* RESET TEMPO;LDA FUELBEQ HMMM       ;* AT ZERO;DEC FUEL       ;* DOWN 1 PIX;HMMM;LDA FUEL;CMP #16BCS NIGHT;LDA #2JSR SFX       ;* LOW FUEL SFX;JSR PULSATAND #%11110000ORA #%00001010 ;* REDSTA SHPINK;JMP DAY;NIGHT;LDA #$79STA SHPINK    ;* RESET SHIP COLOUR;JSR ENDN1     ;* LOW FUEL FX OFF;DAY;RTS;;---------------------------------;ADFUEL     ;* ADD ACC TO FUEL;CLCADC FUELCMP #96BCC ADOKY  ;* STILL OK;LDA #96;STA FUEL   ;* FULL UP;ADOKY;STA FUEL;RTS;;---------------------------------;;* COLOUR FOR FUEL GAUGE;ROSS .BYT $22,$32,$32,$42,$42     .BYT $42,$52,$52,$52,$62     .BYT $62,$62,$62;.END