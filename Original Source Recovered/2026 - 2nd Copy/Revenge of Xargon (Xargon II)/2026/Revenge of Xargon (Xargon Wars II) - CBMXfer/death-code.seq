; >S:DEATH-CODE; PUT "DEATH-CODE";DEATH;; HAS DIED !;LDX #1STX STOP        ;* STOP IT ALL;DEXSTX DEADSTX LASERS      ;* LASER OFF;JSR FIZZLE      ;* DIE !;DEC LIVES       ;* 1 LIFE LESSLDA LIVESBEQ ALLOVR      ;* LOST ALL LIVES;LDA #0STA STOP;JMP STLOOP      ;* BACK TO GAME;ALLOVR;JSR SCREEN      ;* CLS;JMP GAMOVR      ;* GAME OVER;;;;.END