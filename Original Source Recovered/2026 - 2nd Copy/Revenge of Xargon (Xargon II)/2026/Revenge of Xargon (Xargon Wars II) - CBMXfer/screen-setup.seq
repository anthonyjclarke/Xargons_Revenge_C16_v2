; >S:SCREEN-SETUP; PUT "SCREEN-SETUP";; INIT SCREEN;SCREEN;JSR RUSRAS;JSR CLSTOPJSR TITCLS    ;* CLS WINDOW;; CLEAR THE TOP STATUS LINES;LDX #4;SCRL1;TXACLCADC #64STA $0C00,X    ;* 'SCORE';CLCADC #5STA $0C28,X    ;* 'SCORE';LDA #$54STA $0800,XSTA $0816,X;LDA #$44STA $0828,XSTA $083E,X    ;* COLOURS;CPX #4BEQ SCRL1A;TXACLCADC #74STA $0C16,X    ;* 'FUEL';CLCADC #4STA $0C3E,X    ;* 'FUEL';SCRL1A;DEXBPL SCRL1;; PRINT SCORE AND FUEL;JSR LANCOL;; PRINT 2 LAND COLOURS;JSR PRTFUL ;* PRINT FUEL GAUGE;JSR PRLIVE ;* PRINT # LIVES;JSR SCORPT ;* PRINT SCORE;RTS;;---------------------------------;LANCOL;; PRINT THE TWO LAND COLOURS;; LANCL1 = GLOBAL COLOUR;LDX #79LDA LANCL1;TPCL1;STA $0850,X;DEXBPL TPCL1;; TOP DONE;LDX #0;BTCL1;STA $0B20,X;INXCPX #160BNE BTCL1;RTS;;---------------------------------;TITCLS;; CLEAR TITLE WINDOW;LDX #0LDA #32;TITER2;STA $0CA0,XSTA $0DA0,XSTA $0DA0+$7F,X;INXBNE TITER2;RACIAL;JSR RANDOMAND #7BEQ RACIAL;STA COLVAR;ORA #$48;; TOP HALF'S COLOUR;LDX #0;TITR1A;STA $08A0,XSTA $08A0+$A0,X;INXCPX #$A0BNE TITR1A;; NOW BOTTOM HALF'S COLOUR;AND #$0FORA #$60;LDX #0;TITR1B;STA $08A0+$A0+$A0,XSTA $08A0+$A0+$A0+$A0,X;INXCPX #$A0BNE TITR1B;RTS;;---------------------------------;PRSSTR;.BYTE 0,1,2,3,3,$FF,4,5,1,2,$FF.BYTE 6,7,$FF,3,6,8,1,6;;---------------------------------;TITTOP;; PRINT THE TOP BIT ON THE TITLE; PAGE.;JSR CLSTOP;LDX #0LDY #0;SCRL3;LDA PRSSTR,X;CMP #$FFBEQ SCRL4      ;* SPACE;ASL ACLCADC #152       ;* BASE CHAR;STA $0C29,Y    ;* LEFT HALFCLCADC #1STA $0C2A,Y    ;* RIGHT HALF;SCRL4;INYINY;INXCPX #19BNE SCRL3;RTS;;---------------------------------;FLSTOP;; FLASH THE FIRE TO START MESSAGE;LDA SHIPC1      ;* PULSATE COLOURAND #%01110000  ;* LUMINANCEEOR #%01110000  ;* OPPOSITEORA COLVAR;LDX #37;SCRL5;STA $0829,X;DEXBPL SCRL5;RTS;;--------------------------------;CLSTOP;LDX #39;SCRIL;LDA #32STA $0C00,XSTA $0C28,X;LDA #$67STA $0800,XLDA #$57STA $0828,X;DEXBPL SCRIL;RTS;;;.END