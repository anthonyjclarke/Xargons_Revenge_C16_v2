; >S:TOPLAND-PIXEL; PUT "TOPLAND-PIXEL";TOPMVE;; MOVE THE TOP & BOTTOM LAND;LDA TOPSPDBNE TOP4;LDA #0STA IRQWRKBEQ TOP2;TOP4;CMP #1      ;* HALF SPEEDBNE TOP1;STA IRQWRK;INC TOPWRKLDA TOPWRKAND #1BEQ TOP2;RTS;TOP1;SECSBC #1STA IRQWRK  ;* SPEED 1-8;TOP2;LDA TOPLXSECSBC IRQWRK  ;* TOP SPEED;TAY;AND #7STA TOPLX;TYA;AND #8BNE HARTOP ;* NEED BLOCK SCROLL;RTS;HARTOP;LDX #0;BTL1;LDA $0C51,XSTA $0C50,X;LDA $0C79,XSTA $0C78,X;INXCPX #39BNE BTL1;; NOW PUT ON THE NEW BIT OF HILL;DEC TOPCNTBPL BLINK1;JSR TOPNEW;BLINK1;LDY TOPCHRSTY $C9F;INYSTY $C77;INYSTY TOPCHR;RTS;TOPNEW;; START A NEW BLOCK;LDA #3STA TOPCNT;JSR RANDOM;LDA RNDAND #3TAX;LDA RND,X;AND #7;ASL AASL AASL A;CLCADC #192     ;* BASE CHAR;STA TOPCHR;RTS;;.END