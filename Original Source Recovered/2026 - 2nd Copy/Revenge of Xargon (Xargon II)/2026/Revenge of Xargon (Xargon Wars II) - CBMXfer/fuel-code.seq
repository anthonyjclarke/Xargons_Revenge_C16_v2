; >S:FUEL-CODE; PUT "FUEL-CODE";FULCOD;; DO ALL THE MOVING,PRINTING ETC.;LDA DNTFIRBNE NOFULP     ;* NO FUEL;LDA FUELONBNE ITOONF     ;* ONE ON;DEC FUELTM     ;* TEMPOBEQ STFUEL     ;* START A FUEL;NOFULP;RTS;STFUEL;LDA #1STA FUELON     ;* ONE'S ON NOW;LDA TEDAND #%00011111ORA #%11100000STA FUELTM     ;* RESET TEMPO;GETFLY;LDA TED+1;AND #7CLCADC #4;ASL AASL AASL ASTA FUELY;LDA #$98STA FUELX       ;* SET X POS;LDA TED+2AND #$80STA FULDIR      ;* SET DIRECTION;ITOONF;JSR CALCFL      ;* CALC SCREEN;LDX #5LDA #32;FUL4;LDY FUELYP,XSTA (SL),Y;DEXBPL FUL4;; RUB OUT LAST ONE;LDX #47LDA #0;FUL1;STA FULCHR,X;DEXBPL FUL1;; CLEAR FUEL CHAR;;---------------------------------;;     NOW LETS MOVE THE FUEL;LDA KILFUL    ;* REQ TO STOP FUELBNE STPFUL;BIT FULDIRBPL FULUP     ;* GOING UP;LDA FUELYCLCADC #3STA FUELY;CMP #120BCC FUOUT     ;* STILL OK;LDA FULDIREOR #$80STA FULDIR    ;* CHANGE DIRECTION;BNE FUOUT;FULUP         ;* GOING UP;LDA FUELYSECSBC #3STA FUELY;CMP #3BCS FUOUT     ;* STILL OK;LDA FULDIREOR #$80STA FULDIR    ;* CHANGE DIRECTION;FUOUT;DEC FUELX     ;* ACCROSS 1 PIXDEC FUELX     ;* ACCROSS 1 PIXBNE FUOK;STIPIT;LDA #0STA FUELON    ;* FUEL OFF;RTS;STPFUL        ;* STOP FUEL;LDA #3JSR SFX       ;* POW SFX;LDA #0STA KILFUL    ;* ZERO REQUEST;LDA #16JSR ADFUEL    ;* ADD SOME FUEL;LDA #5LDY #6JSR SCORE+2LDA #2LDY #5JSR SCORE+2   ;* ADD 250 POINTS;JMP STIPIT    ;* GO & STOP FUEL;FUOK;;---------------------------------;LDA FUELXLSR AAND #1TAX;LDY TIM24,X       ;* X 24;LDA FUELYAND #7TAX               ;* Y POS;LDA #7STA IRQWRK        ;* COUNT;FUL2;LDA FUELDA,YSTA FULCHR,X;LDA FUELDA+8,YSTA FULCHR+16,X;LDA FUELDA+16,YSTA FULCHR+32,X   ;* 3 COLUMNS;INXINY;DEC IRQWRKBPL FUL2;JSR CALCFL;;  NOW PRINT IT TO THE SCREEN;LDX #5;FUL3;LDA FUELCH,XLDY FUELYP,X;STA (SL),Y;LDA #FULCOLSTA (CL),Y;DEXBPL FUL3         ;* ALL 6 CHARS ON;RTS;;---------------------------------;CALCFL;; CALC SCREEN ADDRESS;LDA FUELXLSR ALSR ATAX;LDA FUELYLSR ALSR ALSR ATAY;JMP XY           ;* CALC SCREEN;;.END