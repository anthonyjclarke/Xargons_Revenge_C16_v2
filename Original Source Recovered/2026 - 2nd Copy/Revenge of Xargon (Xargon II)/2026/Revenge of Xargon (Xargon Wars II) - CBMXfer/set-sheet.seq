; >S:SET-SHEET; PUT "SET-SHEET";; SET UP ALL INFO FOR SCREEN TO BE; PLAYED;SETSHT;LDA SHEET;ASL AASL AASL A;; X8;TAX;LDA SHTABL,XSTA PATDLDA SHTABL+1,XSTA PATD+1;; MOVE-MENT DATA;LDA SHTABL+2,XSTA LANCL1;LDA SHTABL+3,XSTA LANCL2;LDA SHTABL+4,XSTA LANCL3;; COLOURS FOR THE LAND;LDA SHTABL+5,XSTA BAKCOL;; BACKGROUND COLOUR;LDA SHTABL+6,XLDA SHTABL+7,X;; UN-USED AT PRESENT;;---------------------------------;; NOW LETS SET ALIEN POSITIONS;LDX #ALINUM-1;FLTB;LDA #0STA ALSTAT,X  ;* IT'S ALIVE;JSR ALRNDP    ;* GET RANDOM POS;LDA TEMP1STA ALIXPS,X;LDA TEMP2STA ALIYPS,X;LDA TEMP3STA ALIIND,X;DEXBPL FLTB;; FILL STATUS TABLE;LDA #16STA NUMALI;; THATS THE POSITIONS DONE;RTS;;------------------------------;ALRNDP;; CALCULATE A RANDOM POS FOR A; NEW ALIEN .;; TEMP1 = X POS; TEMP2 = Y POS; TEMP3 = INDEX;TXAPHA;DOCTOR;JSR RANDOM;LDA RND+1AND #31CMP #24BCS DOCTOR;CLCADC #14;STA TEMP1       ;* X POS;GOBAK;JSR RANDOM;LDA RND+2AND #15CMP #14BCS GOBAK;STA TEMP2       ;* Y POS;LDA RND+2AND #7STA TEMP3;PLATAX;RTS;;;.END