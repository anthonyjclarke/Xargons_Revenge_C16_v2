; >S:TITLE-LOOP; PUT "TITLE-LOOP";TITLOP;SEI;JSR CLVARS;LDX #1STX STOPSTX TITLESTX MESSPDSTX STPSTR     ;* STOP STARS;INXSTX TOPSPD;INXSTX BOTSPD;LDA #$5FSTA LANCL1     ;* LAND INK COLLDA #$70STA LANCL2     ;* MULTI1LDA #$42STA LANCL3     ;* MULTI2;JSR SETUP      ;* INIT TEDJSR LANCOL     ;* PRINT LAND COLSJSR TITTOP     ;* TITLE AT TOP;JSR SETIRQ     ;* IRQ'S ON;TITLP;LDA #1STA STPSTR     ;* STOP STARS;JSR TITCLS     ;* CLS & NEW COL.AND #$07ORA #$20STA BAKCOL     ;* WINDOW COLS;JSR REVTIT     ;* TITLE ON;JSR INSTAR     ;* INIT STARS;LDA #0STA STPSTR     ;* START STARS;LDA #6STA WORK       ;* LONG DELAY;TITTER;BIT JFIREBPL TUTTER;JMP READY      ;* START GAME;TUTTER;LDX #0JSR DELAY+2;DEC WORKBNE TITTER     ;* LOOP;JSR FADOFF     ;* GET RID - TITLE;JMP TITLP;;---------------------------------;READY;;      GO AND START THE GAME;LDA #1STA STPSTR     ;* STOP STARS;JSR TITCLS;JMP START      ;* GO TO GAME;;;.END