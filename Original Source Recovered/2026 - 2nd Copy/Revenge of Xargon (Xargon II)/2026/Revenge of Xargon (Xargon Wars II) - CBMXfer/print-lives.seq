; >S:PRINT-LIVES; PUT "PRINT-LIVES";; PRINT NO. OF LIVE CHARS;PRLIVE;LDX LIVESBEQ CLLIV      ;* RUB THEM OUT;LIVLP1;TXA;ASL AJSR PRTLIV     ;* PRINT CHAR;DEXBNE LIVLP1;RTS;;---------------------------------;CLLIV;LDX #5LDA #32;LIVLP2;STA $0C0F,XSTA $0C37,X;DEXBPL LIVLP2;RTS;; RUB OUT ALL LIVES;;---------------------------------;PRTLIV;TAY            ;* TL CORNER;LDA #176STA $0C0D,Y;LDA #177STA $0C0E,Y;LDA #178STA $0C35,Y;LDA #179STA $0C36,Y;RTS;;.END