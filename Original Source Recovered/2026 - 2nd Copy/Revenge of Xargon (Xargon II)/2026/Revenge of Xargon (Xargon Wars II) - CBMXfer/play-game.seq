; >S:PLAY-GAME; PUT "PLAY-GAME";; HOLD ALL THE ROUTINES TOGETHER;START;SEI;JSR CLVARS  ;* CLEAR VARS;LDA #1STA STOP;;---------------------------------;;      SET SHIP START VARS;LDA #7STA SHIPY;LDA #3STA YPIX;LDA #<$0DB9STA SHPSCRSTA SHPCOL;LDA #>$0DB9STA SHPSCR+1;LDA #>$09B9STA SHPCOL+1;;---------------------------------;LDA #1STA YPIXSTA FIRCNTSTA FUTEMSTA ALTEMSTA MESSPDSTA DNTFIR  ;* NO FIRING YETSTA STPSTR  ;* STOP STARS;LDA #$50STA SHIPC1;LDA #$51STA SHIPC2;LDA #$79STA SHPINK  ;* SHIP COLOUR;LDA #3STA LIVES   ;* # LIVES;LDA #103STA FUEL    ;* STOP BUG !;CLI         ;* IRQ'S ON;LDA #0STA STOP    ;* ALL GO;JSR INSTAR  ;* INIT STARS;STLOOP      ;* RESTART LOOP;LDA #1STA STPSTR  ;* STOP STARS;LDA #103STA FUEL    ;* REFILL TANKS;JSR SETSHT  ;* SET SHEETJSR SCREEN  ;* SET SCREENJSR PRSHIP  ;* PRINT SHIP;LDA #0STA DEAD    ;* CLEAR DEAD FLAG;LDA LIVESCMP #3BNE NOTSTR  ;* NOT FIRST TIME;JSR STARTE  ;* READY,STEADY,GO;NOTSTR;LDA #0STA STPSTR  ;* START STARS AGAIN;LOOP;JSR CHKPAS  ;* CHECK FOR PAUSE;JSR CHKESC  ;* CHECK ESCAPEBCC FLEETW  ;* NO;JMP TITLOP  ;* GO TO TITLE PAGE;FLEETW;JSR ALIENS;LDA DEAD    ;* DIED ?BEQ LOOP    ;* NO GO BACK;JMP DEATH   ;* DO DEATH;;;.END