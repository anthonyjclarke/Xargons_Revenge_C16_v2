; >S:SET-SHEET; PUT "SET-SHEET";; SET UP ALL INFO FOR SCREEN TO BE; PLAYED;SETSHT;LDX #3;BJH;LDA TED,XSTA RND,X;DEXBPL BJH;; SET RANDOM SEED;;---------------------------------;LDA SHEET;ASL AASL AASL A;; X8;TAX;LDA SHTABL,XSTA PATDLDA SHTABL+1,XSTA PATD+1;; MOVE-MENT DATA;LDA SHTABL+2,XSTA LANCL1;LDA SHTABL+3,XSTA LANCL2STA SHIPC1     ;* SHIP OUTLINE;LDA SHTABL+4,XSTA LANCL3;; COLOURS FOR THE LAND;LDA SHTABL+5,XSTA BAKCOL;; BACKGROUND COLOUR;; LDA SHTABL+6,X; LDA SHTABL+7,X;; UN-USED AT PRESENT;;---------------------------------;; NOW LETS SET ALIEN POSITIONS;LDX #ALINUM-1;FLTB;LDA TEDAND #1STA ALSTAT,X  ;* IT'S ALIVE;JSR ALRNDP    ;* GET RANDOM POS;LDA TEMP1STA ALIXPS,X;LDA TEMP2STA ALIYPS,X;LDA TEMP3STA ALIIND,X;LDA TEMP4STA ALICOL,X;DEXBPL FLTB;; FILL STATUS TABLE;LDX LEVELLDA TOKILL,XTAY              ;* NUMBER TO KILL;CPX #0BNE BENORM       ;* NOT FIRST LVL;LDA SHEET        ;* NOT FIRST SHTBNE BENORM;LDY #16          ;* 16 ALIENS ONLY;BENORM;STY NUMALI;LDA SHEETLSR ACLCADC NUMALISTA NUMALI;SECSBC #16STA REGEN        ;* # TO REGEN;LDA SHEETAND #%00001100LSR ALSR A            ;* 0-3STA WORK;LDA #8SECSBC WORK         ;* 5-8 SPEED;STA ALISPD;LDA MPGVIL,X     ;* FUEL DOWNSTA MPGVAL;RTS;;---------------------------------;TOKILL .BYTE 24,24,32,32,48,48;MPGVIL .BYTE 28,24,20,18,16,14;;---------------------------------;ALRNDP;; CALCULATE A RANDOM POS FOR A; NEW ALIEN .;; TEMP1 = X POS; TEMP2 = Y POS; TEMP3 = INDEX; TEMP4 = COLOUR;TXAPHA;DOCTOR;JSR RANDOM;LDA RND+1AND #31CMP #26BCS DOCTOR;CLCADC #14;STA TEMP1       ;* X POS;GOBAK;JSR RANDOM;LDA RND+2AND #15CMP #14BCS GOBAK;STA TEMP2       ;* Y POS;LDA RNDAND #7STA TEMP3;JSR NUM1T7      ;* GET NUMBER 1-7STA WORKLDA RNDAND #%01110000ORA #%01000000  ;* MIN $40ORA WORK        ;* + COLOURSTA TEMP4;PLATAX;RTS;;;.END