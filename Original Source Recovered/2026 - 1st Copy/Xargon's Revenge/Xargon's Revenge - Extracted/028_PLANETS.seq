; >S:PLANETS; PUT "PLANETS";;; DO THE RANDOM PLANET;BLOBS;DEC ANTTEM       ;* OVERALL TEMPOBNE GPLT;LDA #0STA ANTTEM;; LETS TRY TO START A PLANET;DEC PLTTEM       ;* TEMPOBNE PLTG;GPLT;RTS;PLTG;; TIME FOR A MEGA PLANET;LDA PLANON        ;* ONE ONBNE GPLT;; RIGHT LETS SET A NEW ONE UP;TOOMCH;JSR RANDOMLDA RND+1AND #15;CMP #15BCS TOOMCH;STA PLANY         ;* Y POS;LDA #39STA PLANX         ;* S POS;LDA #1STA PLANON;RTS;;;;.END