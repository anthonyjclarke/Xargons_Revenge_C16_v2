; >S:SCORE-ROUTINES; PUT "SCORE-ROUTINES";SCORE;LDY #7       ;* LSB DIGIT;; SECOND ENTRY POINT;STA SCRADD;ADDLOP;LDA SCRADD;MADONA;CLCADC SCRBUF,YCMP #10BMI SCOREL;SECSBC #10STA SCRBUF,Y;LDA #1DEYBPL MADONA;SCOREL;STA SCRBUF,Y;LDA SCRBUF+3   ;* 10,000BEQ XTR1CMP #5         ;* 50,000BNE NOLIFE;LDY XTRABNE NOLIFE;PUSLIF         ;* ADD 1 LIFE;STA XTRA;BONLIF         ;* ENTRY POINT;INC LIVES;JSR PRLIVE     ;* PRINT THEM;LDA #31STA BONUS;LDA BAKCOLSTA BONUS+1    ;* SAVE COLOUR;JSR NUM1T7STA MAGERS;NOLIFE;RTS;XTR1;LDY XTRACPY #5BNE NOLIFE;BEQ PUSLIF     ;* ADD 1 LIFE;;---------------------------------;; PRINT SCRBUF TO THE SCREEN.;SCORPT;INC SCORCT        ;* COLOURLDA SCORCT;LSR ALSR ALSR A;AND #3TAY;LDA SCORCL,YORA #$60STA SHIPC2        ;* SHIP M/C;LDX #7;SCRPRT;LDA SCRBUF,XCLCADC #82STA SCORPS,X      ;* TOP HALF;CLCADC #10STA SCORPS+40,X   ;* BOTTOM BIT.;LDA SCORCL,YORA #$50;STA SCORPS-$400,X;AND #$0FORA #$40;STA SCORPS-$400+40,X;DEXBPL SCRPRT;LDA BONUSBEQ NOBONS    ;* OVER BEFORE;DEC BONUSBEQ STPBON    ;* STOP BONUS;LDA BONUSAND #15TAX;LDA MAGERS    ;* COLOURAND #15;ORA LUMINX,X  ;* ADD LUMINENCESTA BAKCOL    ;* PULSATE BAK COL;RTS;STPBON;LDA BONUS+1STA BAKCOL    ;* RESTORE COL.;NOBONS;RTS;;---------------------------------;SCORCL;.BYTE 2,3,5,6;.END