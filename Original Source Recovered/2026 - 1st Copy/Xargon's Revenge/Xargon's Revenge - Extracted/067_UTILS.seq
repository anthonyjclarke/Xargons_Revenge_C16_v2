; >S:UTILS; PUT "UTILS";;**************************;;        UTILITIES;;**************************;RANDOM;LDA TEDAND RND+2ADC TED+2ASL AASL AROL RND+3ROL RND+2ROL RND+1ROL RND;; ^ ACORNSOFT RND#;CLCLDY #$29LDX #$FC;RANLOP;TYALDY RND+4,XADC RND+4,XSTA RND+4,XINXBNE RANLOP;RTS;;******************************;DELAY;LDX #$20;LDY #$00;DELLOP;NOPNOPNOP;DEYBNE DELLOP;DEXBNE DELLOP;RTS;;*****************************;CLVARS;LDA #0LDX #18;CLLOP;STA $00,X;INXBNE CLLOP;RTS;;****************************;XY;TYAASL ATAY;LDA SCRPOS,YSTA SCRLDA SCRPOS+1,YSTA SCR+1;TXACLCADC SCRSTA SCRSTA COL;LDA SCR+1ADC #0STA SCR+1;SECSBC #4STA COL+1;RTS;SCRPOS;.WORD $CA0.WORD $CC8,$CF0,$D18,$D40,$D68.WORD $D90,$DB8,$DE0,$E08,$E30.WORD $E58,$E80,$EA8,$ED0,$EF8;;;-----------------------------;RUSRAS;LDA RASTHIAND #1BNE RUSRAS;RUSSER;LDA RASTHIAND #1BEQ RUSSER;RTS;;---------------------------------;NUM1T7;; GET A NUMBER 1 TO 7;STX XTEMP;JSR RANDOMLDA RNDAND #15TAX;LDA LOOKUP,X     ;* 1 TO 7;LDX XTEMP;RTS;LOOKUP;.BYTE 1,2,3,4,5,6,7,4.BYTE 2,3,7,6,5,4,3,2;;.END