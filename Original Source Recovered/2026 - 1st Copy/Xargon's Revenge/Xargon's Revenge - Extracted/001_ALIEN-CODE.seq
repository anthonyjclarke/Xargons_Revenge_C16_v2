; >S:ALIEN-CODE; PUT "ALIEN-CODE";; DO ALL THE ALIEN MOVE CODE;ALIENS;JSR RUSRAS     ;* RASTER POLL;LDA #1;DEC ALTEM      ;* MOVE TEMPOBNE MVEALL;LDA ALISPDSTA ALTEM      ;* RESET TEMPO;LDA #0         ;* MOVE;MVEALL;STA NOBBO;; RUB,MOVE THEN REPRINT;LDA #0STA ALIPNT     ;* POINTER;ALILOP;LDX ALIPNT;LDA ALIXPS,X   ;* X POSSTA ALX;LDA ALIYPS,X   ;* Y POSSTA ALY;LDA ALSTAT,XCMP #$FFBNE NOTGON;JMP ALDEAD     ;* DEAD;NOTGON;AND #$80BEQ NOTEXP     ;* NOT EXPLSOSION;JSR UPEXPL     ;* DO EXPLOSIONJMP DRNO       ;* PRINT IT;NOTEXP;LDA ALSTAT,X   ;* ANIMATIONAND #1;ASL AASL A;CLCADC #213+3STA ALCHR;LDA ALICOL,XSTA GNKCOL     ;* ALIEN COLOUR;; CALC BASE CHAR FOR ALI-PRINT;LDA NOBBO      ;* JUST PRINT ?BNE M10;; IF NOBBO IS '1' THEN JUST; PRINT HIM & DO THE CHECKING; FOR THE LASER;LDA ALSTAT,XEOR #1STA ALSTAT,X   ;* NEXT ANIM.;LDA ALIIND,X   ;* MOVE INDEXTAY;LDA (PATD),Y   ;* MOVE DATASTA ALIDIR;INYLDA (PATD),Y   ;* NEXT MOVEMENT;CMP #$FFBNE NTENDA;LDY #0;NTENDA;TYASTA ALIIND,X   ;* UPDATE INDEX;DRNO;JSR RUBALI;; RUB HIM OUT;LDX ALIPNTLDA ALSTAT,X   ;* STATUSCMP #$FF       ;* NOW DEAD ?BNE ARMAT      ;* OK;; HE MIGHT HAVE JUST DIED IN THE; UPDATE EXPLOSION ROUTINE.;JSR NEWALI     ;* START NEW ALIEN;ARMAT;LDA #1BIT ALIDIR     ;* UPBEQ NOALUP;JSR ALUP;NOALUP;LDA #2BIT ALIDIR     ;* RIGHTBEQ NOALRI;JSR ALRI;NOALRI;LDA #4BIT ALIDIR     ;* DOWNBEQ NOALDO;JSR ALDO;NOALDO;LDA #8BIT ALIDIR     ;* LEFTBEQ NOALLE;JSR ALLE;NOALLE;LDX ALIPNT;LDA ALXSTA ALIXPS,XLDA ALYSTA ALIYPS,X;; ALX,ALY NOW POINT TO NEW POS;M10;JSR PRTALI        ;* NOW PRINT IT;LDA HITITBEQ ALDEAD        ;* NOT HIT;LDA #1JSR SFX           ;* HIT SFX;LDX ALIPNT        ;* POINTERLDA #%10000111STA ALSTAT,X      ;* SET DEAD;LDA TEDAND #3TAY;LDA STTDIR,Y      ;* GET DIRECTIONSTA ALICOL,X      ;* COLOUR = DIR;LDX ATTAKCPX #7BCC BRAINS;LDX #7;BRAINS;STX WORKLDA ALSC1,XLDY #7JSR SCORE+2       ;* UNITS;LDX WORKLDA ALSC2,XLDY #6JSR SCORE+2       ;* TENS;LDX WORKLDA ALSC3,XLDY #5JSR SCORE+2       ;* HUNDREDS;LDA #0STA LASERS        ;* STOP LASER;TAYLDA #32STA (LAS),Y       ;* CLS LASER;ALDEAD;INC ALIPNT        ;* POINTER;LDA ALIPNTCMP #ALINUMBEQ ALIEND;JMP ALILOP     ;* DO NEXT ONE;ALIEND;RTS;;;-------------------------------;ALUP;; MOVE ALIEN UP;LDA ALYBNE ALYOK1;RTS;ALYOK1;DEC ALY;RTS;;*****************;ALRI;; MOVE ALIEN RIGHT;LDA ALXCMP #39BCC ALXOK1;RTS;ALXOK1;INC ALX;RTS;;*****************;ALDO;; MOVE ALIEN DOWN;LDA ALYCMP #14BCC ALYOK2;RTS;ALYOK2;INC ALY;RTS;;*****************;; MOVE ALIEN LEFT;ALLE;LDX ALXDEXBPL ALXOK2;LDX #39;ALXOK2;STX ALX;RTS;;---------------------------------;UPEXPL;; UPDATE THE EXPLOSION;LDA ALSTAT,X    ;* STATUSPHAAND #%11111000STA WORK+1PLA;AND #7SECSBC #1          ;* LIFE COUNTSTA WORKBCS EXPLOK      ;* STILL ON;INC ALIHITLDA ALIHITCMP NUMALI        ;* # TO KILLBNE NTOVB;JMP COMPLE        ;* CLEARED LEVEL;NTOVB;LDA #$FFSTA ALSTAT,X    ;* NOW DEAD;RTS;EXPLOK;TAYLDA EXPCHR,Y    ;* GET BASE CHARSTA ALCHR       ;* READY TO PRINT;LDA WORK+1      ;* DEAD FLAGORA WORK        ;* ANIM. COUNTSTA ALSTAT,X    ;* TO TABLE;JSR NUM1T7ORA #$48        ;* LUMINENCE+MC;STA GNKCOL      ;* FLASH COLOUR;LDA ALICOL,XSTA ALIDIR      ;* DIRECTION;RTS             ;* GO AND PRINT IT;;---------------------------------;STTDIR;.BYTE 1,2,4,2;EXPCHR;.BYTE 224,224,228,228.BYTE 232,232,236,236;;---------------------------------;NEWALI;; THE CURRENT ALIEN WAS DEAD SO; LETS DECIDE WHETHER WE SHOULD; START A NEW ONE.;DEC REGEN       ;* # TO RESTARTBPL STARMZ      ;* START ONE;NOMORE;PLAPLA;JMP ALDEAD      ;* BAK TO LOOP;STARMZ;JSR ALRNDP      ;* POSITIONS;LDA #38STA ALIXPS,XSTA ALX         ;* X POS;LDA TEMP2STA ALIYPS,XSTA ALY         ;* Y POS;LDA TEMP3STA ALIIND,X    ;* PATTERN OFFSET;LDA TEMP4STA ALICOL,X    ;* COLOUR;LDA #0STA ALSTAT,XSTA ALIDIR      ;* NO DIRECTION;LDA #213+3STA ALCHR       ;* BASE CHAR;RTS             ;* START HIM;;---------------------------------;ALSC1;.BYTE 0,5,0,0,0,0,0,0;ALSC2;.BYTE 5,7,0,5,0,5,0,5;ALSC3;.BYTE 0,0,1,1,2,2,3,3;;;.END