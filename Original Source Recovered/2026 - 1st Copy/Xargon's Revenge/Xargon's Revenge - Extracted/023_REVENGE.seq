N*    ;* INIT SCREEN.LIB FUEL-G*    ;* FUEL GAUGE.LIB SHTABLE*   ;* SHEET TABLE.LIB ALI-PRINT* ;* PRINT ALIENS.LIB SHIP-DEF*  ;* SHIP DATA.LIB SCORE*     ;* SCORE STUFF;;---------------------------------;.LIB SHEET1*    ;* SCREEN DATA.LIB SHEET2*    ;* SCREEN DATA.LIB SHEET3*    ;* SCREEN DATA.LIB SHEET4*    ;* SCREEN DATA.LIB SHEET5*    ;* SCREEN DATA.LIB SHEET6*    ;* SCREEN DATA.LIB SHEET7*    ;* SCREEN DATA.LIB SHEET8*    ;* SCREEN DATA.LIB SHEET9*    ;* SCREEN DATA.LIB SHEETA*    ;* SCREEN DATA.LIB SHEETB*    ;* SCREEN DATA.LIB SHEETC*    ;* SCREEN DATA.LIB SHEETD*    ;* SCREEN DATA.LIB SHEETE*    ;* SCREEN DATA.LIB SHEETF*    ;* SCREEN DATA.LIB SHEETG*    ;* SCREEN DATA;; .LIB ALIEN-DAT* ;* ALI-BUMS;.END