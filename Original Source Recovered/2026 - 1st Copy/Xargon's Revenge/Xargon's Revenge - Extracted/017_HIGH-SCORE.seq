; >S:HIGH-SCORE; PUT "HIGH-SCORE";;   SEE IF THE LAST SCORE WAS; GOOD ENOUGH FOR THE HIGH SCORE;HIGH;LDX #7;HLP1A;LDA TPBUFF+32,XAND #15STA WORK,X;DEXBPL HLP1A;; PUT HIGH SCORE INTO BUFFER;LDX #8LDY #8;SEC;HLP1;LDA WORK-1,XSBC SCRBUF-1,Y;DEXDEYBNE HLP1;BCC ITSIN ;* GOOD SCORE NOBBER;LDA #0STA WORK+2;RTS;;---------------------------------;ITSIN;;   PUT SCORE INTO HIGH SCORE;LDX #7;HLP2;LDA SCRBUF,XORA #$30STA TPBUFF+32,X;DEXBPL HLP2;LDX #38;HLP3;LDA CONGRA,XAND #$3FSTA $0E31,X;LDA #$71STA $0A31,X;DEXBPL HLP3;; PRINT MESSAGE;LDA #1STA WORK+2;RTS;CONGRA;.BYTE 'WELL DONE, YOU NOW HAVE THE HIGH-SCORE';;.END