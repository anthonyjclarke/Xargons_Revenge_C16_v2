; >S:INIT-SHEET; PUT"INIT-SHEET";; SET UP THE ALIEN CHARACTERS; AND THE EXPLOSION AT THE START; OF THE SHEET.;; ALIENS HAVE 2 ANIMATIONS = 64; BYTES AND EXPLOSIONS HAVE 4;ALIDEF;LDA SHEETAND #15TAXLDA CONVTB,X  ;* CONVERT ALIENSPHA;AND #3CLCROR AROR AROR ASTA WORK       ;* LO BYTE;PLAAND #%00011100LSR ALSR ACLCSTA WORK+1     ;* HI BYTE;LDA WORKCLCADC #<ALDATASTA WORK;LDA WORK+1ADC #>ALDATASTA WORK+1;; WORK POINTS TO ALIEN DATA;LDY #63;DIF1;LDA (WORK),YSTA $3EA8,Y    ;* CHAR DATA;DEYBPL DIF1       ;* 64 BYTES;JSR CALEXP     ;* GET EXPLOSIONS;RTS;CONVTB;.BYTE 0,1,2,3,4,5,6,7,8.BYTE 9,10,11,12,13,14,15;;;.END