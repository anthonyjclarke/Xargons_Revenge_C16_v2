; >S:RESET-CODE; PUT "RESET-CODE";RESET;; NOP; NOP; NOP;; STA $FF3E; JMP $F2A4         ;* BORING !;SEI;LDA #$38STA TED+19        ;* CHAR $3800;LDA #0STA BORDERSTA BACKGR        ;* BLACK;LDX #7LDY #0LDA #1;RESS1A;STA $3DA0,XSTA $3DA8,Y;ASL A;INYDEXBPL RESS1A        ;* PROG CHARS;LDX #0;RESS1;LDA #180STA $0C00,XSTA $0D00,X;LDA #181STA $0E00,XSTA $0F00,X;LDA #$71STA $0800,XSTA $0900,XSTA $0A00,XSTA $0B00,X;INXBNE RESS1         ;* SCROLL CHARS;LDX #39;RESS2;LDA RESMES,X      ;* MESSAGEAND #$3FSTA $0DE0,X;LDA #$67STA $09E0,X       ;* COLOUR;DEXBPL RESS2;RESS4;JSR RUSRAS        ;* POLL;LDX #15;RESS5;LSR $3DA0,X;BCC RESS6;LDA $3DA0,XORA #$80STA $3DA0,X       ;* SCROLL;RESS6;DEXBPL RESS5         ;* 2 CHARS;JMP RESS4         ;* GO FOR IT !;;---------------------------------;RESMES;.BYTE ' THAT WAS A VERY SILLY THING TO DO !!!! ';;;.END