; >S:BLOB-MOVE; PUT "BLOB-MOVE";; MOVE THE PLANET OR THE METEOR; IF THEY ARE ON;MVEBLB;LDA PLANON      ;* PLANET ONBNE NTPN1;RTS;; LETS MOVE IT THEN;NTPN1;LDX PLANXLDY PLANYJSR XY;LDX #3LDA #32;PLN1;LDY YVAL1,XSTA (SL),Y;DEXBPL PLN1;; RUBBED IT OUT;DEC PLANXLDA PLANXBNE NTFIN1         ;* OK;LDA #0STA PLANON;LDA TEDAND #$3FADC #$C0STA PLTTEM;RTS                ;* GET OUT;NTFIN1;TAXLDY PLANYJSR XY;; NEW SCREEN POS;LDA #191STA CHAR           ;* LAST CHAR;LDX #3;PLN2;LDY YVAL1,XLDA (SL),YCMP #32BEQ CC10;CMP #148           ;* STAR CHARBCC CC11;CMP #152           ;* STAR CHARBCS CC11;CC10;LDA CHARSTA (SL),Y;LDA #PLACOLSTA (CL),Y;CC11               ;* DONT PRINT;DEXBPL PLN2;RTS;;---------------------------------;MVEMET;RTS;;;.END