; >S:LEVEL-CODE; PUT "LEVEL-CODE";; JUST COMPLETED A LEVEL SO DO ALL; THE WHOOPEE STUFF.;LEVCTL;LDA #1STA STPSTR    ;* STOP STARS;JSR TITCLS    ;* CLEAR WINDOW;LDA LEVELCMP #5BNE NOTENL    ;* NOT LAST LEVEL;JMP ENDLVL;;---------------------------------;NOTENL;TAYDEYLDX TIM6,Y;LDY #0;HATE1;LDA PLANNM,XSTA NOBBE1+30,Y ;* PLANET DONE.;LDA PLANNM+6,XSTA NOBBE2+30,Y ;* NEXT ONE;INXINYCPY #6BNE HATE1;; PUT NAMES OF PLANETS IN STRING;LDA #<$0CF0STA SCRLDA #>$0CF0STA SCR+1      ;* SCREEN POINTER;LDA #<LVL1STA WORKLDA #>LVL1STA WORK+1     ;* MESSAGE POINTER;JSR PRTMES     ;* PRINT MESSAGE;LDA #<$0CCCSTA WORKLDA #>$0CCCSTA WORK+1;JSR MEDAL      ;* PRINT MEDAL;LDA #<$0CEASTA WORKLDA #>$0CEASTA WORK+1;JSR MEDAL      ;* PRINT MEDAL;LDA #5LDY #4JSR SCORE+2    ;* 5000 POINTS;JSR BONLIF     ;* EXTRA LIFE;LDA #0STA STPSTR     ;* STARS GO;LDA #8STA WORK;DODO1;LDX #0JSR DELAY+2;DEC WORKBNE DODO1;LDA #111STA FULINC;RTS            ;* BAK TO THE GAME;;---------------------------------;ENDLVL;LDA #<$0CA0STA SCRLDA #>$0CA0STA SCR+1      ;* SCREEN POINTER;LDA #<LVL2STA WORKLDA #>LVL2STA WORK+1     ;* MESSAGE POINTER;JSR PRTMES     ;* PRINT MESSAGE;LDA #$77STA ALCHR;LDX #9;ENDIT1;LDY YVAL1,XLDA ALCHRSTA $0DE0+32,Y;LDA #$67STA $09E0+32,Y;DEC ALCHRDEXBPL ENDIT1;LDA #0     ;* OK TO USE NOW.STA KILLCOSTA JDOWNSTA JFIRESTA STPSTR ;* STARS GO;TROKIT;BIT JFIREBMI AGAINP;BIT JDOWNBPL TROKIT;LDA #1STA STOP;JSR CLRSHP  ;* RUB OUT SHIPJMP ALLOVR  ;* TIRED;AGAINP;JMP REPLAY  ;* PLAY AGAIN;;---------------------------------;PLANNM;; 6 PLANET NAMES;.BYTE 'MAGNUM'.BYTE 'KAYLIH'.BYTE 'NEBULA'.BYTE 'NILBEG'.BYTE 'XARGON';;---------------------------------;LVL1;.BYTE '         WELL DONE SPACE CADET!',0.BYTE '         ----------------------',0.BYTE 0;NOBBE1;.BYTE '    YOU HAVE CONQUERED PLANET .......',0,0.BYTE '    FOR THIS YOU RECEIVE A BONUS LIFE',0.BYTE '   AND A GOLD MEDAL WORTH 5000 POINTS.',0.BYTE 0,0;NOBBE2;.BYTE '     PREPARE TO ATTACK PLANET .......';.BYTE $FF;;---------------------------------;LVL2;.BYTE '      CONGRATULATIONS MEGA PERSON!',0.BYTE '      ----------------------------',0,0.BYTE '    YOU HAVE DEFEATED PLANET XARGON.',0,0.BYTE '       YOU ARE NOW DECORATED AS:-',0,0.BYTE '   THE BEST HYPER GALACTIC ZAPPER EVER!',0,0.BYTE '         HERE IS YOUR AWARD :-',0,0,0.BYTE '   PRESS FIRE TO RESTART OR DOWN TO END.',0.BYTE $FF;;---------------------------------;PRTMES;JSR NIWCOL;MESP1;LDX #16JSR DELAY+2;JSR RUSRAS       ;* RASTER POLL;LDY #0;LDA (WORK),YCMP #$FF         ;* END OF MESSAGEBNE MESP2;RTS;MESP2;CMP #0BEQ NEWLIN       ;* CR.;LDY WORK+2;AND #$3FSTA (SCR),Y;LDA SCR+1PHA;SECSBC #4STA SCR+1        ;* COLOUR ADD.;LDA WORK+3       ;* COLOURSTA (SCR),Y;PLASTA SCR+1;INC WORK+2       ;* SCREEN POINTER;MESP3;INC WORKBNE MESP4;INC WORK+1;MESP4            ;* DATA POINTER;JMP MESP1        ;* LOOP;NEWLIN           ;* NEW LINE;LDA SCRCLCADC #40STA SCR          ;* NEXT LINE DOWN;LDA SCR+1ADC #0STA SCR+1          ;JSR NIWCOL       ;* NEW COLOUR;JMP MESP3        ;* START AGAIN;;---------------------------------;NIWCOL;LDA #0STA WORK+2       ;* SCREEN POINTER;JSR NUM1T7ORA #$60STA WORK+3       ;* COLOUR;RTS;;---------------------------------;MEDAL;LDA #$7BSTA ALCHR;LDX #5;MED1;LDY YVAL1,XLDA ALCHRSTA (WORK),Y;LDA WORK+1PHA;SECSBC #4STA WORK+1;LDA #$67STA (WORK),Y;PLASTA WORK+1;DEC ALCHRDEXBPL MED1;RTS;;;.END