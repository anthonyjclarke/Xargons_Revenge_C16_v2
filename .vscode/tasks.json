{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PlatformIO: Build",
            "type": "process",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "c16"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "PlatformIO: Debug Build",
            "type": "process",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "c16_debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "PlatformIO: Run Game v1 in VICE",
            "type": "process",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "c16",
                "-t",
                "upload"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "PlatformIO: Run Game v2 in VICE",
            "type": "process",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "c16_v2",
                "-t",
                "upload"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "PlatformIO: Clean",
            "type": "process",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "c16",
                "-t",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build: Xargon's Revenge",
            "type": "process",
            "command": "python3",
            "args": [
                "scripts/restore_c16.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run: Game v1 (development) in VICE",
            "type": "process",
            "command": "python3",
            "args": [
                "scripts/run_vice.py",
                "--game-version",
                "1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "Build: Xargon's Revenge"
        },
        {
            "label": "Run: Game v2 (cassette release) in VICE",
            "type": "process",
            "command": "python3",
            "args": [
                "scripts/run_vice.py",
                "--game-version",
                "2"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "Build: Xargon's Revenge"
        },
        {
            "label": "Run: Supplied Original",
            "type": "process",
            "command": "python3",
            "args": [
                "scripts/run_vice.py",
                "--original"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: Restoration",
            "type": "process",
            "command": "python3",
            "args": [
                "-m",
                "unittest",
                "discover",
                "-s",
                "test",
                "-p",
                "test_*.py",
                "-v"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Verify: VICE Gameplay and Reference",
            "type": "process",
            "command": "python3",
            "args": [
                "scripts/verify_vice.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "Build: Xargon's Revenge"
        },
        {
            "label": "Probe: Original Rules",
            "type": "process",
            "command": "python3",
            "args": [
                "scripts/probe_gameplay_rules.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "Verify: VICE Gameplay and Reference"
        }
    ]
}
